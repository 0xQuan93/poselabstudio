# Frontend
VITE_BACKEND_URL=http://localhost:3001
VITE_DISCORD_CLIENT_ID=your_discord_application_client_id
VITE_ENABLE_VMC_BRIDGE=false
VITE_ENABLE_POSE_EXPORT=false

# Backend
PORT=3001
GEMINI_API_KEY=your_server_side_gemini_api_key
LP_SESSION_SECRET=replace_with_a_long_random_secret

# Discord OAuth & Bot Configuration
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_bot_token_starting_with_MTE...
DISCORD_STUDIO_CHANNEL_ID=the_channel_id_for_the_feed
DISCORD_POSE_CHANNEL_ID=the_channel_id_for_published_poses

# Discord Deep LP Engine Configuration
DISCORD_GUILD_ID=your_discord_server_guild_id
DISCORD_ROLE_ID_GENERAL_TECH=your_discord_role_id_for_100_lp
DISCORD_ROLE_ID_LAB_TECH=your_discord_role_id_for_500_lp
DISCORD_ROLE_ID_STUDIO_TECH=your_discord_role_id_for_1000_lp

# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
